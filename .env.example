# ---------------------------------------------------------------------------
# Root environment template for docker-compose / local orchestration.
# Copy to `.env` at the repository root. Service-specific templates live in
# `backend/.env.example` and `frontend/.env.example`.
# ---------------------------------------------------------------------------

# Base URL the browser uses to reach the FastAPI service. This is inlined into
# the frontend at build time, so rebuild the frontend image when it changes.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Origins allowed by the backend CORS middleware (frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ports published by docker-compose
BACKEND_PORT=8000
FRONTEND_PORT=3000
