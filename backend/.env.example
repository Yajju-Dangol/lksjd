# ---------------------------------------------------------------------------
# Backend environment variables. Copy to `backend/.env` and adjust as needed.
# ---------------------------------------------------------------------------

# Runtime
ENVIRONMENT=development
PORT=8000

# Comma-separated list of origins allowed to call the API (the Next.js dev server)
CORS_ORIGINS=http://localhost:3000

# Elexon BMRS Insights API
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Dataset scope (the challenge is strictly January 2026)
DATA_YEAR=2026
DATA_MONTH=1

# Day-ahead gate closure: forecasts published at/after this UTC hour on D-1 are excluded
GATE_CLOSURE_HOUR_UTC=11

# Local on-disk cache for raw Elexon responses (guards against upstream downtime)
CACHE_DIR=./data/cache
