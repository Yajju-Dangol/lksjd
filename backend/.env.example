# ---------------------------------------------------------------------------
# Backend environment variables. Copy to `backend/.env` and adjust as needed.
# ---------------------------------------------------------------------------

# Runtime
ENVIRONMENT=development
PORT=8000

# Comma-separated list of origins allowed to call the API (the Next.js dev server)
CORS_ORIGINS=http://localhost:3000

# Elexon BMRS Insights API
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=30
ELEXON_MAX_RETRIES=2

# Dataset scope (the challenge is strictly January 2026)
DATA_YEAR=2026
DATA_MONTH=1

# Day-ahead gate closure: forecasts published at/after this UTC hour on D-1 are excluded
GATE_CLOSURE_HOUR_UTC=11

# Local JSON cache used as the resilience fallback. Relative paths resolve
# against the process working directory; the default is backend/data/.
# CACHE_FILE=./data/cache_jan2026.json

# How long a fetched dataset stays fresh before a refresh is attempted (seconds)
CACHE_TTL_SECONDS=86400
